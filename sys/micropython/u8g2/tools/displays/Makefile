# Builds ../../u8g2_displays_table.h from displays.txt.
#
# The display data comes from codebuild, the u8g2 code generator
# (tools/codebuild/codebuild.c). It has option -t: setup names on stdin, one
# D(...) line per display on stdout, and option -l: list the setup names
# micropython can use.
#
# usage: make          (in this directory)
#        make list     (setup names for displays.txt)
#        make clean

U8G2_DIR = ../../../../..
CODEBUILD_C = $(U8G2_DIR)/tools/codebuild/codebuild.c
TABLE = ../../u8g2_displays_table.h
BUILD = build

all: $(TABLE)

$(TABLE): $(BUILD)/codebuild displays.txt
	{ echo '/* generated by tools/displays/Makefile from displays.txt, do not edit */'; \
	  echo '/* D(python_name, display_cb, cad_cb, ll_hvline, tile_width, tile_height, com) */'; \
	  $(BUILD)/codebuild -t < displays.txt; } > $@.tmp || { rm -f $@.tmp; exit 1; }
	mv $@.tmp $@

$(BUILD)/codebuild: $(CODEBUILD_C)
	mkdir -p $(BUILD)
	$(CC) -o $@ $(CODEBUILD_C)

list: $(BUILD)/codebuild
	@$(BUILD)/codebuild -l

clean:
	rm -rf $(BUILD)

.PHONY: all list clean
